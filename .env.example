# Copy this file to .env and fill in your own values. Never put real keys in this file.
# Find these in Supabase: Project Settings -> API.
# Use the anon / public key only. Never use the service role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE
